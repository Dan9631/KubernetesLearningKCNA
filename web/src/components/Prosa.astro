---
// Contenido del módulo con los plegados y las comprobaciones de lib/plegar.ts
import { plegar } from '../lib/plegar';
import { COMPROBACIONES } from '../lib/comprueba';
interface Props { module: string }
const { module } = Astro.props;
const html = plegar(await Astro.slots.render('default'), COMPROBACIONES[module] ?? []);
---
<Fragment set:html={html} />
