---
import Base from '../layouts/Base.astro';
import PedirDiploma from '../components/PedirDiploma.svelte';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---
<Base title="Diploma de finalización" description="Pide tu constancia de finalización del curso KCNA, firmada y verificable por cualquiera." width="read">
  <article class="page">
    <header class="head">
      <p class="kicker">Diplomas</p>
      <h1>Diploma de finalización</h1>
      <p class="lead">Si terminaste el curso y tienes un código de invitación, aquí pides tu constancia. Va firmada, y cualquiera puede <a href={`${base}/verificar/`}>comprobar que es auténtica</a>.</p>
    </header>
    <PedirDiploma client:load />
    <p class="note">Es una constancia de finalización de este curso. No es la certificación KCNA, que solo emiten la CNCF y la Linux Foundation.</p>
  </article>
</Base>

<style>
  .page { max-width: 860px; margin: 0 auto; padding-top: 28px; }
  .kicker { color: var(--ink-2); font-size: 0.92rem; margin-bottom: 8px; }
  .lead { font-size: 1.15rem; color: var(--ink-2); margin-top: 10px; max-width: var(--measure); }
  .note { color: var(--ink-3); font-size: 0.86rem; margin-top: 28px; max-width: var(--measure); }
</style>
