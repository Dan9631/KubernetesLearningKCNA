// Worker de sincronización del curso KCNA. Despliegue: ver README.md de esta carpeta.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "kcna-sync",
  "main": "src/index.js",
  "compatibility_date": "2026-10-01",
  "observability": { "enabled": true },
  // Orígenes del sitio que pueden llamar al Worker (sitio publicado y copias locales)
  "vars": {
    "ALLOWED_ORIGINS": "https://dan9631.github.io,http://localhost:4321,http://127.0.0.1:4322,http://localhost:8080"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "kcna-sync",
      // lo imprime `npx wrangler d1 create kcna-sync`; en local sirve cualquier valor
      "database_id": "00000000-0000-0000-0000-000000000000"
    }
  ],
  // Limpieza diaria de registros abandonados (03:17 UTC)
  "triggers": { "crons": ["17 3 * * *"] }
  // Límite de peticiones opcional (por registro, aproximado). Descoméntalo si tu plan lo permite:
  // , "ratelimits": [{ "name": "RATE_LIMITER", "namespace_id": "1001", "simple": { "limit": 30, "period": 60 } }]
}
